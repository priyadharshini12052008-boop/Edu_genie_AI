# Required for Gemini-powered features.
GEMINI_API_KEY=your_gemini_api_key_here

# Current Gemini model used by the application.
# You can change this to another text-generation model available to your API key.
GEMINI_MODEL=gemini-2.5-flash

# Keep false for the simplest/lightest setup.
# Set true only after installing requirements-local.txt.
USE_LOCAL_EXPLANATION=false

# Used when USE_LOCAL_EXPLANATION=true.
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M
